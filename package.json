{
  "name": "durable-agent-memory",
  "version": "0.1.0",
  "description": "Cache-friendly hierarchical long-term memory for Pi Durable on Cloudflare",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/core/memory.ts",
    "./pi": "./src/pi/extension.ts",
    "./storage": "./src/storage/durable-sqlite.ts",
    "./node": "./src/storage/node-sqlite.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "smoke": "tsx scripts/smoke.ts",
    "test:recovery": "tsx scripts/local-recovery.ts",
    "check": "npm run typecheck && npm test && wrangler deploy --dry-run",
    "test:remote-recovery": "tsx scripts/remote-recovery.ts",
    "build:bridge": "esbuild src/bridge/cli.ts --bundle --platform=node --format=esm --outfile=dist/pi-durable.mjs",
    "test:bridge": "npm run build:bridge && tsx scripts/bridge-smoke.ts",
    "test:workspace": "tsx scripts/workspace-smoke.ts"
  },
  "dependencies": {
    "@cloudflare/computer": "0.4.1",
    "@earendil-works/chord": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-durable": "1.0.2",
    "agents": "0.26.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cd-slash/durable-agent-memory.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "undici": "7.29.1",
    "guarded-fetch": "0.1.5"
  }
}
