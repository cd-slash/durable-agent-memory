{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "durable-agent-memory",
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENTS",
        "class_name": "MemoryAgent"
      },
      {
        "name": "BILLING",
        "class_name": "BillingControl"
      },
      {
        "name": "TAILNET",
        "class_name": "TailnetGateway"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MemoryAgent"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "BillingControl"
      ]
    },
    {
      "tag": "v3-tailnet-gateway",
      "new_sqlite_classes": [
        "TailnetGateway"
      ]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "vars": {
    "MODEL": "@cf/zai-org/glm-4.7-flash",
    "TAILNET_ENABLED": "false",
    "TAILNET_TARGETS": "[]"
  },
  "limits": {
    "cpu_ms": 50
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "containers": [
    {
      "class_name": "TailnetGateway",
      "scheduling_policy": "default",
      "image": "./sandbox/Tailnet.Dockerfile",
      "instance_type": "lite",
      "max_instances": 1,
      "image_build_context": "."
    }
  ]
}
